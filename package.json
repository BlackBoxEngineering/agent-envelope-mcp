{
  "name": "agent-envelope-mcp",
  "version": "1.1.0",
  "mcpName": "io.github.BlackBoxEngineering/agent-envelope-mcp",
  "description": "MCP adapter for AgentEnvelope: sovereign verification, hosted decisions, delegates, legitimacy, and mint receipts.",
  "type": "module",
  "bin": {
    "agent-envelope-mcp": "bin/agent-envelope-mcp.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "bin",
    "src",
    "server.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node bin/agent-envelope-mcp.js",
    "start:http": "node bin/agent-envelope-mcp.js --http --port 8787"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agent-envelope-sdk": "^1.4.5",
    "zod": "^4.4.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-envelope",
    "agent",
    "authority",
    "delegation",
    "capabilities",
    "verification",
    "identity",
    "sovereign"
  ],
  "author": "BlackBox Engineering",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackBoxEngineering/agent-envelope-mcp.git"
  },
  "homepage": "https://github.com/BlackBoxEngineering/agent-envelope-mcp#readme",
  "bugs": {
    "url": "https://github.com/BlackBoxEngineering/agent-envelope-mcp/issues"
  }
